{
  // ChattaMesh Rev 2.4 — Cloudflare Workers static assets.
  //
  // This file is REQUIRED. It is what tells Cloudflare the site lives in
  // public/. Deploy without it and you get a Worker with no assets attached,
  // which answers 404 on every URL.
  //
  //   npx wrangler deploy
  //
  // "name" must match the Worker already serving chattame.sh. If it doesn't,
  // wrangler creates a SECOND Worker instead of updating the live one, and
  // the site appears unchanged.
  //
  // The site is pure static assets: no Worker script, no Durable Object, no
  // bindings. Everything under public/ is served as-is.

  "name": "chattamesh",
  "compatibility_date": "2026-09-27",

  "assets": {
    "directory": "./public",

    // Serves /getting-started for public/getting-started.html and 301s the
    // .html form. Every canonical URL the site emits is extensionless, so
    // changing this means changing the canonicals in seo.py to match.
    "html_handling": "auto-trailing-slash",

    // 404.html is not present; unknown paths fall through to Cloudflare's
    // default. Add one to public/ and switch this to "404-page" if you want a
    // branded miss.
    "not_found_handling": "none"
  }
}
